# App Configuration
NEXT_PUBLIC_APP_NAME="SaaS App"
NEXT_PUBLIC_APP_DESCRIPTION="A production-ready SaaS boilerplate"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_LOGO="/logo.png"

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Authentication (better-auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourapp.com"
SUPPORT_EMAIL="support@yourapp.com"

# OAuth Social Login (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Analytics (optional - all are optional)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Company Info (optional)
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# Feature Flags
NEXT_PUBLIC_ENABLE_TWO_FACTOR="false"
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION="true"
# Moteur d'images. Le code passe par une interface (lib/image) : changer de
# fournisseur ne touche qu'un adaptateur.
OPENAI_IMAGE_MODEL="gpt-image-1"
# Moteur de narration (lib/speech). gpt-4o-mini-tts est le plus rapide des
# trois : la voix se genere scene par scene, chaque seconde s'y multiplie.
OPENAI_SPEECH_MODEL="gpt-4o-mini-tts"

# Object storage (S3-compatible: Cloudflare R2, MinIO, Backblaze, Scaleway)
# Requis pour generer les visuels du storyboard : l'API refuse les data: URLs,
# donc chaque image doit etre hebergee avant d'entrer en base.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Base des URL publiques du bucket (souvent un domaine CDN, pas l'endpoint S3)
S3_PUBLIC_URL=""
# Optionnels : "auto" convient a R2 ; passer false si le bucket a son propre DNS
S3_REGION="auto"
S3_FORCE_PATH_STYLE="true"
