// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  isAdmin       Boolean   @default(false)
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  stripeCustomerId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]
  blogs         Blog[]
  apiKeys       ApiKey[]
  organizationInvitationsSent OrganizationInvitation[] @relation("OrganizationInvitationsSent")
  organizationMemberships OrganizationMember[]   @relation("OrganizationMemberships")
  twoFactor     TwoFactor?
  twoFactorEnabled Boolean @default(false)
  emailChangeRequests EmailChangeRequest[]
  videoProjectsCreated VideoProject[] @relation("VideoProjectsCreated")
  videoProjectsLocked  VideoProject[] @relation("VideoProjectsLocked")
  creditTransactions   CreditTransaction[]
  creditPurchases      CreditPurchase[]
  recoveryCodes        RecoveryCode[] @relation("RecoveryCodes")
  trustedDevices       TrustedDevice[] @relation("TrustedDevices")

  @@index([roleId])
  @@index([isAdmin])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  activeOrganizationId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String   @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  issuer       String?  // Better Auth credential issuer (e.g., "local:credential")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Log {
  id        Int      @id @default(autoincrement())
  message   String
  level     String   @default("info")
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  resource    String   // e.g., "user", "post", "settings"
  action      String   // e.g., "create", "read", "update", "delete"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  stripePriceId   String   @unique
  stripeProductId String
  amount          Int      // Amount in cents
  currency        String   @default("usd")
  interval        String   // "month" or "year"
  features        String[] // Array of feature strings
  tier            String   @default("starter") // free | starter | pro | enterprise
  isPopular       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
  quotas        PlanQuota[]
  featureGates  PlanFeatureGate[]

  @@index([interval])
  @@index([isActive])
  @@index([tier])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable until scripts/migrate-billing-to-organizations.ts backfills it.
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  planId               String
  plan                 Plan      @relation(fields: [planId], references: [id])
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  status               String    // active, canceled, past_due, etc.
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([planId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  stripePaymentId   String   @unique
  amount            Int      // Amount in cents
  currency          String   @default("usd")
  status            String   // succeeded, pending, failed
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text // Rich text content from Tiptap
  excerpt     String?  @db.Text
  coverImage  String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  published   Boolean  @default(false)
  publishedAt DateTime?
  tags        String[] // Array of tag strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([slug])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String    // First 12 chars for display (e.g., "sk_live_xxxx")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([keyHash])
}
model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  logo        String?
  metadata    String?
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  videoProjects VideoProject[]
  stripeCustomerId   String?   @unique
  subscriptions      Subscription[]
  creditWallet       CreditWallet?
  creditTransactions CreditTransaction[]
  creditPurchases    CreditPurchase[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("member")
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("OrganizationInvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([email])
  @@index([organizationId])
}
// Stores contact form submissions for admin review and audit trail
model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phoneNumber String?
  message     String
  ipAddress   String?
  status      String   @default("new") // new, read, replied
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model TimelineClip {
  id             String       @id @default(cuid())
  videoProjectId String
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  mediaId   String
  trackId   String
  start     Float
  duration  Float
  offset    Float
  speed     Float    @default(1)
  volume    Float    @default(1)
  isLocked  Boolean  @default(false)

  annotations Annotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackId])
  @@index([videoProjectId])
}

model VideoProject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("VideoProjectsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  title       String @db.VarChar(255)
  status      String @default("draft")
  step        String @default("prompt")
  aspectRatio String @default("16:9")

  params           Json
  script           Json
  panels           Json
  whiteboardConfig Json
  schemaVersion    Int  @default(1)

  lockedById    String?
  lockedBy      User?     @relation("VideoProjectsLocked", fields: [lockedById], references: [id], onDelete: SetNull)
  lockExpiresAt DateTime?

  clips TimelineClip[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, deletedAt, updatedAt])
  @@index([lockExpiresAt])
}

model Annotation {
  id        String   @id @default(cuid())
  clipId    String
  clip      TimelineClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  label     String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  narrativeRole String? @db.VarChar(255)
  subtitle  String?  @db.Text
  sequence  Int?

  region    Json
  startMs   Int
  durationMs Int

  reveal    Json
  handPath  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId])
}

/// Un export video. L'etat vit en base pour que toutes les instances le voient :
/// suivi, annulation et telechargement peuvent tomber sur une autre que celle
/// qui rend. heartbeatAt avance pendant le rendu ; au-dela d'un delai sans
/// signal, l'instance est tenue pour morte et le job libere sa place.
model RenderJob {
  id          String   @id
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  status      String   @db.VarChar(20)
  progress    Int      @default(0)
  outputKey   String?  @map("output_key")
  error       String?  @db.Text
  heartbeatAt DateTime @default(now()) @map("heartbeat_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, heartbeatAt])
  @@index([userId, status])
  @@index([userId, projectId, status])
  @@index([createdAt])
  @@map("render_jobs")
}

/// Compteur de rate limit partage par toutes les instances.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// Evenement de webhook reclame par une instance. completedAt nul et claimedAt
/// ancien : l'instance est tombee en plein traitement, un nouvel envoi peut le
/// reprendre.
model ProcessedWebhookEvent {
  id          String    @id
  type        String
  claimedAt   DateTime  @default(now()) @map("claimed_at")
  completedAt DateTime? @map("completed_at")

  @@index([claimedAt])
  @@map("processed_webhook_events")
}

model PlanQuota {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  key       String   // monthly_credits | max_projects | max_video_duration_sec | max_export_resolution | max_org_members | max_storage_gb
  value     Int      // -1 = unlimited
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
}

model PlanFeatureGate {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  key       String   // premium_templates | custom_branding | remove_watermark | api_access | priority_support
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
}

model CreditActionCost {
  id        String   @id @default(cuid())
  action    String   @unique
  cost      Int
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditWallet {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCredits      Int          @default(0)
  purchasedCredits Int          @default(0)
  resetAt          DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([resetAt])
}

model CreditTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Actor; kept as history when the member is deleted.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           String       // plan_grant | consumption | purchase | expiration | refund
  amount         Int          // positive = credit, negative = debit
  balance        Int          // total balance after this transaction
  source         String?      // plan | purchased | mixed
  action         String?
  referenceId    String?
  description    String?
  // Consumption split ({ fromPlan, fromPurchases }) so a refund restores the same pools.
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([type])
  @@index([referenceId])
}

model CreditPurchase {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripePaymentId  String       @unique
  credits          Int
  amount           Int          // cents
  currency         String       @default("usd")
  remainingCredits Int
  expiresAt        DateTime
  createdAt        DateTime     @default(now())

  @@index([organizationId, expiresAt])
  @@index([expiresAt])
}

// Auth Features - Phase 1, 2, 3
model MagicLink {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("RecoveryCodes", fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("TrustedDevices", fields: [userId], references: [id], onDelete: Cascade)
  deviceHash  String
  token       String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([token])
  @@index([userId])
}
